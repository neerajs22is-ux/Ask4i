# ==============================================================================
# Ask4i (RAG-4i) — Environment & Secrets Template
# ==============================================================================
#
# IMPORTANT: Never commit actual secret values or credentials to version control.
# Ask4i uses a clean two-tier architecture:
#   1. Frontend Browser Environment (.env.local in web/) — Public publishable keys only.
#   2. Edge Function Secrets (Supabase Secrets Vault) — Private provider keys only.
#
# Follow SETUP_GUIDE.md for step-by-step instructions on obtaining free keys
# and setting up your own self-contained instance without touching any author resources.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (web/.env.local)
# ------------------------------------------------------------------------------
# These two values are loaded by Next.js and exposed in the browser bundle.
# They are public by design; all security is enforced by PostgreSQL Row Level Security (RLS).
# Obtain these from: https://supabase.com/dashboard/project/<your-project-ref>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<your-anon-key>


# ------------------------------------------------------------------------------
# 2. EDGE FUNCTION SECRETS (Set via Supabase CLI: supabase secrets set KEY=VALUE)
# ------------------------------------------------------------------------------
# DO NOT put these in web/.env.local!
# These must be set strictly in Supabase Edge Secrets so they remain server-side.

# Worker Secret (Generate with: openssl rand -hex 32)
# Gates cron-driven embed worker calls and internal ingestion triggers.
WORKER_CRON_KEY=your_generated_random_worker_cron_secret

# Embeddings API Key (Jina AI or Voyage AI)
# Free 1M tokens at: https://jina.ai or https://dash.voyageai.com
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Generation API Key & Model ID (AWS Bedrock Mantle / Anthropic)
# Bearer key and model identifier for grounded answer synthesis
MANTLE_API_KEY=your_llm_inference_api_key
ANSWER_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional Runtime Controls
CORRECTNESS_CHECKER_ENABLED=false
PROVIDER_KILL_SWITCH=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
