{"$schema": "http://json-schema.org/draft-07/schema#",
 "title": "RAG-4i claim-level evaluation artifacts",
 "type": "object",
 "definitions": {
  "label": {"enum": ["SUPPORTED", "REFUTED", "UNSUPPORTED", "NOT_CHECKABLE"]},
  "gold_claim": {
   "type": "object",
   "required": ["claim_id", "question_id", "claim_text", "expected_label", "reason"],
   "properties": {
    "claim_id": {"type": "string"},
    "question_id": {"type": "string"},
    "claim_text": {"type": "string"},
    "citations": {"type": "array", "items": {"type": "integer"}},
    "expected_label": {"$ref": "#/definitions/label"},
    "supporting_source_ids": {"type": "array", "items": {"type": "string"}},
    "supporting_excerpt": {"type": "string"},
    "reason": {"type": "string"}
   }},
  "prediction": {
   "type": "object",
   "required": ["claim_id", "question_id", "predicted_label"],
   "properties": {
    "claim_id": {"type": "string"},
    "question_id": {"type": "string"},
    "predicted_label": {"$ref": "#/definitions/label"},
    "best_chunk": {"type": ["string", "null"]},
    "recall": {"type": "number"},
    "detail": {"type": "string"}
   }}
 },
 "properties": {
  "gold": {"type": "array", "items": {"$ref": "#/definitions/gold_claim"}},
  "predictions": {"type": "array", "items": {"$ref": "#/definitions/prediction"}}
 }}
